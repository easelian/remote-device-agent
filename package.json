{
  "name": "remote-device-hub",
  "version": "0.7.2",
  "description": "Connect Windows, Linux and macOS devices to your Remote Device Hub gateway",
  "type": "module",
  "bin": {
    "remote-device-hub": "bin/remote-device-hub.mjs",
    "remote-device-agent": "bin/remote-device-hub.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "bin/remote-device-hub.mjs",
    "bundle/agent.mjs",
    "packaging/windows-logon.ps1",
    "THIRD_PARTY_LICENSES",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node scripts/test.mjs",
    "pack:runtime": "sh packaging/build-runtime.sh",
    "prepack": "npm run typecheck && npm run build",
    "pack:check": "node scripts/check_package.mjs",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "style:check": "biome check ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
